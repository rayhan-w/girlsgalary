generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id               String           @id @default(cuid())
  name             String
  nameBn           String?
  slug             String           @unique
  sku              String           @unique
  description      String
  descriptionBn    String?
  fabric           String?
  careInstructions String?
  regularPrice     Float
  offerPrice       Float
  discountPercent  Int              @default(0)
  coverImage       String
  images           String           @default("[]") // JSON string of image URLs
  videoUrl         String?
  categoryId       String
  subCategoryId    String?
  brandId          String?
  isPublished      Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  isNewArrival     Boolean          @default(true)
  isBestSelling    Boolean          @default(false)
  viewCount        Int              @default(0)
  totalStock       Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  category         Category         @relation(fields: [categoryId], references: [id])
  subCategory      SubCategory?     @relation(fields: [subCategoryId], references: [id])
  brand            Brand?           @relation(fields: [brandId], references: [id])
  variants         ProductVariant[]
  reviews          Review[]
  orderItems       OrderItem[]
  stockHistory     StockHistory[]
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  size       String      // e.g. S, M, L, XL, Free Size
  colorName  String      // e.g. Maroon, Bottle Green, Baby Pink
  colorHex   String?     // e.g. #800000
  sku        String?
  stock      Int         @default(0)
  priceDiff  Float       @default(0)
  image      String?
  createdAt  DateTime    @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  stockHistory StockHistory[]
}

model Category {
  id             String        @id @default(cuid())
  name           String
  nameBn         String?
  slug           String        @unique
  photo          String?
  banner         String?
  order          Int           @default(0)
  isHidden       Boolean       @default(false)
  sizeChartImage String?
  sizeChartData  String?       // JSON string of size measurements table
  createdAt      DateTime      @default(now())

  products       Product[]
  subCategories  SubCategory[]
}

model SubCategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  nameBn     String?
  slug       String    @unique
  order      Int       @default(0)
  createdAt  DateTime  @default(now())

  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  createdAt DateTime  @default(now())

  products  Product[]
}

model Order {
  id               String              @id @default(cuid())
  orderNumber      String              @unique // GG-1001
  customerName     String
  customerPhone    String
  customerAddress  String
  district         String              // 64 districts
  deliveryZone     String              // inside_dhaka, near_dhaka, outside_dhaka
  deliveryCharge   Float
  subtotal         Float
  discount         Float               @default(0)
  grandTotal       Float
  orderNote        String?
  paymentMethod    String              @default("COD") // COD, BKASH_MANUAL, NAGAD_MANUAL
  paymentStatus    String              @default("PENDING") // PENDING, VERIFIED, PAID, FAILED
  senderPhone      String?
  transactionId    String?
  status           String              @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED, RETURNED
  isRestocked      Boolean             @default(false) // Ensures cancelling restocks exactly once
  customerId       String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  customer         Customer?           @relation(fields: [customerId], references: [id])
  items            OrderItem[]
  statusHistory    OrderStatusHistory[]
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  productId    String
  variantId    String?
  productName  String
  productImage String
  size         String?
  color        String?
  price        Float
  quantity     Int
  total        Float

  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  staffName String?
  createdAt DateTime @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  password  String?
  isBlocked Boolean   @default(false)
  createdAt DateTime  @default(now())

  orders    Order[]
  addresses Address[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  name       String
  phone      String
  address    String
  district   String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Review {
  id            String   @id @default(cuid())
  productId     String
  customerName  String
  customerPhone String?
  rating        Int      @default(5)
  comment       String
  photoUrl      String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reply         String?
  createdAt     DateTime @default(now())

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountType    String    // PERCENTAGE, FIXED
  discountValue   Float
  minOrderAmount  Float     @default(0)
  categoryLimitId String?
  usageLimit      Int?
  usedCount       Int       @default(0)
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

model SiteSettings {
  id                        String   @id @default("default")
  shopName                  String   @default("Girlsgalary")
  logo                      String?
  favicon                   String?
  hotline                   String   @default("01700000000")
  whatsappNumber            String   @default("8801700000000")
  topBarOffer               String   @default("Free delivery across Bangladesh on orders over ৳2,000!")
  address                   String   @default("Dhaka, Bangladesh")
  email                     String   @default("support@girlsgalary.com")
  facebookUrl               String   @default("https://facebook.com/girlsgalary")
  bkashNumber               String   @default("01700000000")
  nagadNumber               String   @default("01700000000")
  bkashInstructions         String   @default("Send money to our Personal bKash number, then submit your sender number & TrxID below.")
  nagadInstructions         String   @default("Send money to our Personal Nagad number, then submit your sender number & TrxID below.")
  isCodEnabled              Boolean  @default(true)
  deliveryChargeInsideDhaka Float    @default(70)
  deliveryChargeNearDhaka   Float    @default(100)
  deliveryChargeOutsideDhaka Float   @default(130)
  freeDeliveryThreshold     Float    @default(2000)
  deliveryTimeInsideDhaka   String   @default("24-48 Hours")
  deliveryTimeOutsideDhaka  String   @default("2-4 Days")
  trustStripCod             String   @default("Cash on Delivery available nationwide")
  trustStripDelivery        String   @default("Fast home delivery all over Bangladesh")
  trustStripExchange        String   @default("Easy 3-day exchange guarantee")
  footerAbout               String   @default("Girlsgalary is your premier destination for authentic ladies fashion in Bangladesh.")
  footerCopyright           String   @default("© 2026 Girlsgalary. All rights reserved.")
  metaPixelId               String?
  metaCapiToken             String?
  gtmId                     String?
  ga4Id                     String?
  metaDomainVerification    String?
  isPixelEnabled            Boolean  @default(false)
  isGtmEnabled              Boolean  @default(false)
  isGa4Enabled              Boolean  @default(false)
}

model Banner {
  id             String   @id @default(cuid())
  title          String
  subtitle       String?
  imageUrl       String
  mobileImageUrl String?
  linkUrl        String   @default("/shop")
  buttonText     String   @default("Shop Now")
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model StaffUser {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  role      String   @default("STAFF") // OWNER, MANAGER, STAFF
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  staffName String
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())
}

model ContentPage {
  id        String   @id @default(cuid())
  slug      String   @unique // about-us, delivery-policy, return-policy, privacy-policy, terms, faq
  title     String
  content   String
  contentBn String?
  updatedAt DateTime @updatedAt
}

model StockHistory {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  type      String          // STOCK_IN, STOCK_OUT, ORDER_DEDUCT, ORDER_RESTOCK, MANUAL_ADJUST
  quantity  Int
  note      String?
  staffName String?
  createdAt DateTime        @default(now())

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
}
